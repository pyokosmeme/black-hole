{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "black-hole",
  "main": "_worker.js",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/",
      "/p/*",
      "/llms.txt",
      "/.well-known/*",
      "/xrpc/*"
    ]
  },
  "vars": {
    "ADMIN_DIDS": "did:plc:ccxl3ictrlvtrrgh5swvvg47,did:plc:drrstoxu4to57dhv453ziznq"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "149e36b52d1c43518ce7f2d91c22528c"
    }
  ]
}
